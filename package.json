{
  "name": "sfp-qa-lab",
  "private": true,
  "scripts": {
    "test": "npm run test:static && npm run test:sophy-arch && npm run test:sophy-benchmark && npm run test:financial && npm run test:polish",
    "test:static": "node qa/static-check.mjs",
    "test:sophy-arch": "node qa/sophy-v3-architecture-test.mjs",
    "test:sophy-benchmark": "node qa/sophy-v3-benchmark-100-test.mjs",
    "test:financial": "node -r ./qa/env-setup.js ./node_modules/.bin/playwright test qa/financial.spec.js",
    "test:polish": "node -r ./qa/env-setup.js ./node_modules/.bin/playwright test qa/month-and-theme-polish.spec.js",
    "test:e2e": "node -r ./qa/env-setup.js ./node_modules/.bin/playwright test qa/ui.spec.js",
    "test:qa": "node -r ./qa/env-setup.js ./node_modules/.bin/playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "pngjs": "^7.0.0"
  }
}
